# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO PARA VERCEL Y ENTORNO LOCAL
# Copia este archivo a .env o configúralo en el panel de Vercel (Project Settings > Environment Variables)
# ==============================================================================

# URL canónica de la aplicación desplegada
VITE_APP_URL=https://estrategiatecnologica.vercel.app

# Endpoint del Web App de Google Apps Script con permisos 'Anyone'
VITE_GAS_API_URL=https://script.google.com/macros/s/AKfycbyaRpLE0EJ-25X1rqw5z0gRzmC3Dah-aTMvWtIlz3gI2Uk1f79eyguvchCj9aNgun65/exec

# Identificador de la hoja de cálculo Google Spreadsheets
VITE_SPREADSHEET_ID=1pTxVBSWoSmOH02h9ehrNTJJFAgNpcFlueYckdXxGXec

# Clave de blindaje para validar integridad de peticiones locales
VITE_SECURITY_SALT=praxis_iribarren_ubv_soberania_2026

# Modo de entorno: 'development' | 'production'
VITE_APP_ENV=production

# Protección de privacidad y soberanía de datos (deshabilita rastreadores)
VITE_ENABLE_COMMERCIAL_TELEMETRY=false
